{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Difftacular",
  "version": "0.1.2",
  "identifier": "dev.difftastic.studio",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Difftacular",
        "width": 1440,
        "height": 940,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "A syntax-aware visual diff tool",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
